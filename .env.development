# Desarrollo: el servidor recarga solo al guardar archivos
# Abre http://localhost:3000 y no refresques a mano

# Si los cambios no se ven (ej. carpeta en red o WSL), descomenta la siguiente línea:
# CHOKIDAR_USEPOLLING=true

# Para abrir el navegador al iniciar (por defecto CRA ya lo hace)
# BROWSER=chrome
